{
  "name": "nexus-vps-agent",
  "version": "0.1.0",
  "description": "A lightweight autonomous Telegram agent for managing Debian VPS infrastructure through natural language.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "libsql": "^0.5.29",
    "pino": "^9.6.0",
    "zod": "^3.25.21"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "telegram",
    "ai-agent",
    "vps",
    "debian"
  ],
  "license": "MIT"
}
