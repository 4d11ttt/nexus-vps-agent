# ============================================================
# NEXUS VPS Agent — environment configuration
# Copy to `.env` and fill in the values. Never commit `.env`.
# ============================================================

# Application
NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info

# Database
DATABASE_PATH=./data/agent.db

# Workspace (SOUL.md, USER.md, MEMORY.md, skills/)
WORKSPACE_DIR=./workspace

# ------------------------------------------------------------
# LLM provider (generic OpenAI-compatible)
# ------------------------------------------------------------
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=65536
LLM_CONTEXT_WINDOW=1000000
LLM_REASONING_EFFORT=high
# LLM_TIMEOUT_MS=120000
# LLM_MAX_RETRIES=3

# Agent
AGENT_MAX_ITERATIONS=50

# Tools
TOOL_SHELL_TIMEOUT_MS=300000
TOOL_MAX_OUTPUT_BYTES=1048576

# ------------------------------------------------------------
# Telegram
# ------------------------------------------------------------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# ------------------------------------------------------------
# Scheduler
# ------------------------------------------------------------
# SCHEDULER_ENABLED=false
# SCHEDULER_POLL_INTERVAL_MS=30000

# ------------------------------------------------------------
# Memory
# ------------------------------------------------------------
# MEMORY_MAX_RESULTS=5
# MEMORY_CONTEXT_LIMIT=4000

# ------------------------------------------------------------
# MCP (optional extension point)
# ------------------------------------------------------------
# MCP_ENABLED=false

